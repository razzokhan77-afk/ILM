# ILM Backend Environment Configuration

# App
NODE_ENV=development
APP_NAME=ILM-BookStore
PORT=5000
API_PREFIX=/api/v1
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Database - PostgreSQL (Primary)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ilm_db
DB_USER=ilm_user
DB_PASSWORD=ilm_password_secure_2024
DB_SYNC=false
DB_LOGGING=false

# Database - MongoDB
MONGODB_URI=mongodb://localhost:27017/ilm_db
MONGODB_DB_NAME=ilm_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=ilm_jwt_super_secret_key_change_in_production_2024
JWT_REFRESH_SECRET=ilm_jwt_refresh_secret_key_change_in_production_2024
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=ilm-bookstore

# OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

APPLE_CLIENT_ID=your_apple_client_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=your_apple_private_key
APPLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/apple/callback

FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/v1/auth/facebook/callback

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=usd

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# AWS S3 (File Storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET_NAME=ilm-bookstore-files
AWS_S3_BUCKET_URL=https://ilm-bookstore-files.s3.amazonaws.com
AWS_CLOUDFRONT_URL=https://d1example.cloudfront.net

# Cloudinary (Images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@ilmbookstore.com
EMAIL_FROM_NAME=ILM Book Store

# Firebase (Auth & Notifications)
FIREBASE_PROJECT_ID=ilm-bookstore
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@ilm-bookstore.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://ilm-bookstore.firebaseio.com
FIREBASE_STORAGE_BUCKET=ilm-bookstore.appspot.com

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elastic_password

# Bull Queue (Background Jobs)
REDIS_QUEUE_HOST=localhost
REDIS_QUEUE_PORT=6379

# AI Services
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4-turbo

# 2FA
OTP_SECRET=ilm_otp_secret_key
OTP_EXPIRES_IN=5m

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://ilmbookstore.com

# Session
SESSION_SECRET=ilm_session_secret_key
SESSION_EXPIRES_IN=24h

# File Upload
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=pdf,epub,mobi,docx,txt

# Commission
PLATFORM_COMMISSION_PERCENTAGE=15
MIN_WITHDRAWAL_AMOUNT=10

# Subscription
PREMIUM_PRICE_MONTHLY=9.99
PREMIUM_PRICE_YEARLY=99.99
PREMIUM_FEATURES=unlimited_downloads,offline_reading,ad_free,ai_summaries

# Currency
DEFAULT_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,EUR,GBP,PKR,INR,AED,SAR,CAD,AUD

# Language
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,ar,ur,hi,zh,pt,ru

# CDN
CDN_URL=https://cdn.ilmbookstore.com

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=logs/app.log
